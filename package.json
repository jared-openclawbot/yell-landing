{
  "name": "yell",
  "version": "0.1.0",
  "private": true,
  "description": "Declarative UI for the serializable web",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "bun run --workspaces build",
    "build:core": "bun run --filter @yell/core build",
    "build:schema": "bun run --filter @yell/schema build",
    "build:ai-adapter": "bun run --filter @yell/ai-adapter build",
    "build:linter": "bun run --filter @yell/linter build",
    "bundle": "bun run scripts/bundle.mjs",
    "bundle:playground": "bun run scripts/build-playground.mjs",
    "bundle:all": "bun run bundle && bun run bundle:playground",
    "test": "bun run test --workspaces",
    "dev": "bun run dev --workspaces"
  },
  "engines": {
    "node": ">=18",
    "bun": ">=1.0"
  },
  "devDependencies": {
    "terser": "^5.46.2",
    "vitest": "^4.1.4"
  },
  "dependencies": {
    "js-yaml": "^4.1.1"
  }
}
